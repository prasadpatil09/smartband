{
  "name": "iot-data-receiver",
  "version": "1.0.0",
  "private": true,
  "description": "Local Express receiver and live dashboard for IoT device data",
  "main": "server.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "node --env-file-if-exists=.env server.js",
    "build": "vite build",
    "ml:train": "node scripts/train-fall-model.js",
    "seed:demo": "node scripts/seed-demo.js",
    "start": "node --env-file-if-exists=.env server.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongoose": "^9.10.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "vite": "^8.3.2"
  }
}
